{
  "name": "@wr/analytics-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic derived-value calculations shared by client (browser) and server (Node) for the statistics workbench — browser-safe, no Node-only APIs",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./*": { "types": "./dist/*.d.ts", "import": "./dist/*.js", "require": "./dist/*.cjs" }
  }
}
