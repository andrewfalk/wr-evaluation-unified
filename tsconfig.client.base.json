{
  "//": "클라이언트(src/) 타입검사 공통 설정 (REFACTORING_ROADMAP P0-6). 직접 쓰지 않고 tsconfig.client.json(TS, strict)·tsconfig.client.js.json(JS, 완화)이 확장한다.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "paths": {
      "@wr/contracts": ["./shared/dist/index.d.ts"],
      "@wr/contracts/*": ["./shared/dist/*.d.ts"],
      "@wr/analytics-core": ["./packages/analytics-core/dist/index.d.ts"],
      "@wr/analytics-core/*": ["./packages/analytics-core/dist/*.d.ts"]
    }
  }
}
