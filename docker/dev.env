# DEVELOPMENT ONLY — never use these values on a server.
#
# docker-compose.yml has no password defaults (SEC-A L13, 7.3.0): every database password is required
# (`${VAR:?}`), so a production .env.production that misses one stops at `docker compose config` instead of
# silently running with a dev value. Development supplies them through this file as an interpolation input:
#
#   docker compose --env-file docker/dev.env --env-file .env up -d postgres
#
# (the dev scripts — scripts/dev-stack-up.ps1, scripts/dev-intranet-stack.ps1 — do this). A later --env-file wins,
# and shell variables win over both, so a value in your .env or shell overrides these. They are the same values
# the compose file used as defaults before 7.3.0, so an existing development database keeps working.
POSTGRES_PASSWORD=changeme_for_dev_only
OWNER_DB_PASSWORD=changeme_owner_dev_only
APP_DB_PASSWORD=changeme_app_dev_only
AUDIT_DB_PASSWORD=changeme_audit_reader
