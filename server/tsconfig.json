{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@wr/contracts": ["node_modules/@wr/contracts/dist/index.d.cts"],
      "@wr/contracts/*": ["node_modules/@wr/contracts/dist/*.d.cts"],
      "@wr/analytics-core": ["node_modules/@wr/analytics-core/dist/index.d.cts"],
      "@wr/analytics-core/*": ["node_modules/@wr/analytics-core/dist/*.d.cts"]
    }
  },
  "include": ["src/**/*.ts"]
}
