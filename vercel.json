{
  "installCommand": "npm ci --include-workspace-root --workspace @wr/contracts --workspace @wr/analytics-core && node scripts/prebuild-shared.mjs",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist/web",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
