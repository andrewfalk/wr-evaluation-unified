        "        <label class=\"radio-label\">",
        "          <input type=\"radio\" name=\"theme\" value=\"dark\" />",
        "          \"다크\"",
        "    <div class=\"settings-section modal-section pattern-surface\">",
        "      <div class=\"settings-section-title\">",
        "        \"폰트 크기\"",
